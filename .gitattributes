# Normalize text to LF in the repository and in every checkout, so scripts and
# generated-looking files are byte-identical on Windows, Linux and macOS runners.
* text=auto

*.go    text eol=lf
*.mod   text eol=lf
*.sum   text eol=lf
*.sh    text eol=lf
*.ps1   text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.svg   text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.tmpl  text eol=lf

*.png   binary
*.ico   binary
*.icns  binary
*.woff2 binary
*.zip   binary
*.gz    binary
*.ttf   binary
*.syso  binary

# Byte-exact test fixtures (zip archives, including the deliberately broken readme.notzip).
internal/rules/internal/zipaes/testdata/** binary

# Authoring tools and website prototypes are not shipped application code.
.agents/skills/** linguist-vendored
designs/pail-site/** linguist-vendored
*.webp binary
