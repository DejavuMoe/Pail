{
  "schemaVersion": 2,
  "project": {
    "name": "Pail landing page",
    "slug": "pail-site",
    "surfaceType": "marketing"
  },
  "content": {
    "defaultProfile": "marketing-approved",
    "inventory": "content-inventory.json",
    "approvedCopySources": []
  },
  "designSources": "design-sources.json",
  "surfaces": [
    {
      "id": "landing-page",
      "contentProfile": "marketing-approved",
      "prototype": {
        "entry": "index.html",
        "assetPath": "index.html",
        "files": [
          "index.html",
          "styles.css",
          "i18n.js",
          "app.js",
          "assets/pail-icon.svg",
          "assets/main-light.webp",
          "assets/main-dark.webp"
        ],
        "states": [
          "theme-system",
          "theme-light",
          "theme-dark",
          "lang-en",
          "lang-zh",
          "os-windows",
          "os-macos",
          "os-linux",
          "os-unknown",
          "mobile-nav-open",
          "terminal-ls",
          "terminal-sync",
          "terminal-presign",
          "terminal-json",
          "download-source-github",
          "download-source-mirror",
          "download-mirror-unavailable",
          "no-javascript",
          "reduced-motion",
          "width-360",
          "width-768",
          "width-1280",
          "width-1920",
          "not-found"
        ],
        "stableIds": [
          "top",
          "features",
          "cli",
          "privacy",
          "download",
          "mobile-nav"
        ]
      },
      "production": {
        "routeOrWindow": "https://pail.download/ (en) and https://pail.download/zh/ (zh-Hans)",
        "files": [
          "site/templates/index.html.tmpl",
          "site/templates/404.html.tmpl",
          "site/locales/en.json",
          "site/locales/zh-Hans.json",
          "site/static/styles.css",
          "site/static/app.js",
          "tools/site/main.go"
        ],
        "interfaces": [
          "go run ./tools/site -out <dir> -version <x.y.z>",
          ".woodpecker/site.yml"
        ],
        "tests": [
          "go test ./tools/site/..."
        ]
      },
      "status": "implemented"
    },
    {
      "id": "docs-pages",
      "contentProfile": "marketing-approved",
      "prototype": {
        "entry": "docs.html",
        "assetPath": "docs.html",
        "files": [
          "docs.html",
          "docs.zh.html",
          "docs-cli.html",
          "docs-cli.zh.html",
          "changelog.html",
          "changelog.zh.html",
          "license.html",
          "license.zh.html",
          "docs.css",
          "docs.js",
          "styles.css",
          "app.js",
          "i18n.js"
        ],
        "states": [
          "theme-light",
          "theme-dark",
          "lang-en",
          "lang-zh",
          "english-only-note",
          "toc-current-section",
          "width-390",
          "width-760",
          "width-1080",
          "width-1440"
        ],
        "stableIds": [
          "install",
          "quick-start",
          "command-line",
          "build-from-source",
          "data-and-privacy",
          "platform-status"
        ]
      },
      "production": {
        "routeOrWindow": "https://pail.download/docs/, /docs/cli/, /changelog/, /license/ and the same under /zh/",
        "files": [
          "site/templates/docs.html.tmpl",
          "site/static/docs.css",
          "site/static/docs.js",
          "site/static/styles.css",
          "site/static/app.js",
          "site/locales/en.json",
          "site/locales/zh-Hans.json",
          "tools/site/docs.go",
          "tools/site/markdown.go",
          "tools/site/main.go"
        ],
        "interfaces": [
          "go run ./tools/site -out <dir> -version <x.y.z>"
        ],
        "tests": [
          "go test ./tools/site/..."
        ]
      },
      "status": "implemented"
    }
  ]
}
