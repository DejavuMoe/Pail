<!DOCTYPE html>
<html lang="{{.HTMLLang}}" data-lang="{{.Lang}}">
<head>
  {{template "head" .}}
  <title>{{.Title}} · Pail</title>
  <meta name="description" content="{{.Description}}">
  {{template "social" .}}
  <script type="application/ld+json">{{.StructuredData}}</script>
  <link rel="stylesheet" href="{{asset "docs.css"}}">
</head>
<body class="docs page-{{.PageKey}}">
{{template "header" .}}
<div class="docs-shell">
  <nav class="docs-nav" id="docs-nav" aria-label="{{t "docsNavLabel"}}">
    <button class="docs-menu" type="button" aria-expanded="false" aria-controls="docs-groups" hidden><span>{{.Group}}</span><b>{{.Title}}</b><svg class="ic" aria-hidden="true"><use href="#i-chev"/></svg></button>
    <div class="docs-groups" id="docs-groups">
    {{- range .Nav}}
    <div class="nav-group">
      <h2>{{.Label}}</h2>
      <ul>
        {{- range .Items}}
        <li><a href="{{.URL}}"{{if .Current}} aria-current="page"{{end}}>{{.Label}}</a></li>
        {{- end}}
      </ul>
    </div>
    {{- end}}
    </div>
  </nav>

  <main id="main" class="doc">
    <header class="doc-head">
      <p class="doc-crumb"><a href="{{.Links.Docs}}">{{t "navDocs"}}</a><span aria-hidden="true">/</span><span>{{.Group}}</span></p>
      <h1>{{.Title}}</h1>
      {{- if .Lede}}
      <p class="doc-lede">{{.Lede}}</p>
      {{- end}}
      {{- if .EnglishOnly}}
      <p class="doc-note">{{t "licenseNote"}}</p>
      {{- end}}
    </header>
    {{- if .Pane}}
    <div class="doc-fig" aria-hidden="true">
      <div class="win">
        <div class="win-bar"><span class="win-dots"><i></i><i></i><i></i></span><span class="win-title">{{.PaneTitle}}</span></div>
        <div class="win-body">
          {{template "pane" .}}
        </div>
      </div>
    </div>
    {{- end}}
    <div class="prose"{{if .EnglishOnly}} lang="en"{{end}}>
{{.Content}}
    </div>
    <footer class="doc-foot">
      <nav class="pager" aria-label="{{t "pagerLabel"}}">
        {{- with .Prev}}
        <a class="pager-prev" href="{{.URL}}" rel="prev"><span>{{t "pagerPrev"}}</span><b>{{.Label}}</b></a>
        {{- end}}
        {{- with .Next}}
        <a class="pager-next" href="{{.URL}}" rel="next"><span>{{t "pagerNext"}}</span><b>{{.Label}}</b></a>
        {{- end}}
      </nav>
      <p class="doc-source"><a href="{{.SourceURL}}">{{t "editSource"}}</a></p>
    </footer>
  </main>

  {{- if .TOC}}
  <aside class="toc" id="toc" aria-labelledby="toc-title">
    <h2 id="toc-title">{{t "tocTitle"}}</h2>
    <ol>
      {{- range .TOC}}
      <li><a href="#{{.ID}}">{{.Text}}</a></li>
      {{- end}}
    </ol>
  </aside>
  {{- end}}
</div>
{{template "footer" .}}
{{template "palette" .}}
</body>
</html>
