</svg>
{{- end}}

{{define "header" -}}
<a class="skip" href="#main">{{t "skip"}}</a>
{{template "icons"}}
<header class="bar" id="top">
  <div class="bar-in">
    <a class="brand" href="{{.Links.Home}}" aria-label="{{t "homeLabel"}}">
      <img src="{{asset "pail-icon.svg"}}" alt="" width="26" height="26"><span>Pail</span>
    </a>
    <nav class="bar-nav" id="site-nav" aria-label="{{t "navLabel"}}">
      <a href="{{.Links.Home}}#features">{{t "navFeatures"}}</a>
      <a href="{{.Links.Home}}#cli">{{t "navCli"}}</a>
      <a href="{{.Links.Docs}}"{{if .PageKey}} aria-current="true"{{end}}>{{t "navDocs"}}</a>
      <a href="{{.Links.Changelog}}">{{t "navChangelog"}}</a>
      <a href="{{.GitHub}}">GitHub</a>
    </nav>
    <div class="bar-tools">
      <button class="search-btn" type="button" data-palette-open aria-keyshortcuts="Control+K Meta+K" hidden>
        <svg class="ic" aria-hidden="true"><use href="#i-search"/></svg><span class="search-label">{{t "searchDocs"}}</span><kbd data-mod>Ctrl K</kbd>
      </button>
      <a class="lang" href="{{.OtherPath}}" hreflang="{{.OtherHTMLLang}}" lang="{{.OtherHTMLLang}}" data-lang-switch="{{.OtherLang}}">{{t "otherLanguage"}}</a>
      <button class="icon-btn theme-btn" type="button" data-theme-toggle hidden
        data-label-system="{{t "themeSystem"}}" data-label-light="{{t "themeLight"}}" data-label-dark="{{t "themeDark"}}" aria-label="{{t "themeSystem"}}">
        <svg class="ic ic-system" aria-hidden="true"><use href="#i-system"/></svg>
        <svg class="ic ic-light" aria-hidden="true"><use href="#i-sun"/></svg>
        <svg class="ic ic-dark" aria-hidden="true"><use href="#i-moon"/></svg>
      </button>
      <a class="btn btn-primary btn-sm bar-dl" href="{{.Links.Home}}#download">{{t "navDownload"}}</a>
      <button class="icon-btn menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="{{t "menu"}}" hidden>
        <svg class="ic ic-open" aria-hidden="true"><use href="#i-menu"/></svg>
        <svg class="ic ic-close" aria-hidden="true"><use href="#i-close"/></svg>
      </button>
    </div>
  </div>
</header>
{{- end}}


{{define "palette" -}}
<dialog class="palette" id="palette" aria-labelledby="palette-title" data-index="{{.SearchIndex}}">
  <div class="palette-box">
    <h2 class="sr" id="palette-title">{{t "searchDocs"}}</h2>
    <div class="palette-field">
      <svg class="ic" aria-hidden="true"><use href="#i-search"/></svg>
      <input id="palette-input" type="search" autocomplete="off" spellcheck="false" placeholder="{{t "searchPlaceholder"}}"
        aria-label="{{t "searchDocs"}}" aria-controls="palette-list">
      <kbd>Esc</kbd>
    </div>
    <ul class="palette-list" id="palette-list"></ul>
    <p class="palette-foot"><span><kbd>↑</kbd><kbd>↓</kbd> {{t "searchMove"}}</span><span><kbd>Enter</kbd> {{t "searchOpen"}}</span></p>
  </div>
</dialog>
{{- end}}

{{define "footer" -}}
<footer class="foot">
  <div class="foot-in">
    <div class="foot-brand">
      <a class="brand" href="{{.Links.Home}}"><img src="{{asset "pail-icon.svg"}}" alt="" width="22" height="22"><span>Pail</span></a>
      <p>{{t "footLine"}}</p>
    </div>
    <nav class="foot-nav" aria-label="{{t "footNavLabel"}}">
      <div>
        <h2>{{t "footProduct"}}</h2>
        <ul>
          <li><a href="{{.Links.Home}}#download">{{t "navDownload"}}</a></li>
          <li><a href="{{.Links.Home}}#features">{{t "navFeatures"}}</a></li>
          <li><a href="{{.Links.Cli}}">{{t "pageCli"}}</a></li>
          <li><a href="{{.Links.Changelog}}">{{t "pageChangelog"}}</a></li>
        </ul>
      </div>
      <div>
        <h2>{{t "footDocs"}}</h2>
        <ul>
          <li><a href="{{.Links.Docs}}">{{t "footOverview"}}</a></li>
          <li><a href="{{.Links.Install}}">{{t "footInstall"}}</a></li>
          <li><a href="{{.Links.Connect}}">{{t "footConnect"}}</a></li>
          <li><a href="{{.Links.Privacy}}">{{t "footPrivacy"}}</a></li>
        </ul>
      </div>
      <div>
        <h2>{{t "footProject"}}</h2>
        <ul>
          <li><a href="{{.GitHub}}">{{t "footSource"}}</a></li>
          <li><a href="{{.GitHub}}/releases">{{t "footReleases"}}</a></li>
          <li><a href="{{.GitHub}}/issues">{{t "footIssues"}}</a></li>
          <li><a href="{{.Links.License}}">{{t "footLicense"}}</a></li>
        </ul>
      </div>
    </nav>
    <p class="foot-legal">{{t "trademark"}}</p>
  </div>
</footer>
<script type="application/json" id="site-strings">{{.Runtime}}</script>
<script src="{{asset "site.js"}}" defer></script>
{{- end}}
