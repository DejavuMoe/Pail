<!DOCTYPE html>
<html lang="en" data-lang="en" data-theme="light" data-theme-pref="system">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{tl "en" "notFoundTitle"}} · Pail</title>
  <meta name="robots" content="noindex">
  <meta name="color-scheme" content="light dark">
  <link rel="icon" href="{{asset "pail-icon.svg"}}" type="image/svg+xml">
  <script>
    (function () {
      var d = document.documentElement, pref = 'system';
      try { pref = localStorage.getItem('pail-theme') || 'system'; } catch (e) {}
      var dark = pref === 'dark' || (pref !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
      d.setAttribute('data-theme', dark ? 'dark' : 'light');
    })();
  </script>
  <link rel="stylesheet" href="{{asset "styles.css"}}">
</head>
<body>
  <main class="not-found">
    <div class="wrap not-found-inner">
      <a class="brand" href="/"><img src="{{asset "pail-icon.svg"}}" alt="" width="28" height="28"><span>Pail</span></a>
      <section>
        <h1 class="section-title">{{tl "en" "notFoundTitle"}}</h1>
        <p class="section-lede">{{tl "en" "notFoundBody"}}</p>
        <a class="btn btn-primary" href="/">{{tl "en" "notFoundHome"}}</a>
      </section>
      <section lang="zh-Hans" data-lang="zh">
        <h2 class="section-title">{{tl "zh" "notFoundTitle"}}</h2>
        <p class="section-lede">{{tl "zh" "notFoundBody"}}</p>
        <a class="btn btn-secondary" href="/zh/">{{tl "zh" "notFoundHome"}}</a>
      </section>
    </div>
  </main>
</body>
</html>
