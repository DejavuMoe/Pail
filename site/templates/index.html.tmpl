      <div class="footer-brand">
        <a class="brand" href="#top"><img src="{{asset "pail-icon.svg"}}" alt="" width="28" height="28"><span>Pail</span></a>
        <p class="footer-made"><span>{{t "madeBy"}}</span> <a href="https://dejavu.moe">Dejavu Moe</a></p>
      </div>
      <nav class="footer-col" aria-labelledby="fc-product">
