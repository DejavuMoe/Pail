<!DOCTYPE html>
<html lang="{{.HTMLLang}}" data-lang="{{.Lang}}">
<head>
  {{- if eq .Lang "en"}}
  <script>
    (function () {
      var l = navigator.languages && navigator.languages[0] || navigator.language || '', saved = null;
      try { saved = localStorage.getItem('pail-lang'); } catch (e) {}
      if (!saved && /^zh(-|$)/i.test(l)) location.replace('{{.PathZh}}' + location.hash);
    })();
  </script>
  {{- end}}
  {{template "head" .}}
  <title>{{t "metaTitle"}}</title>
  <meta name="description" content="{{.Description}}">
  {{template "social" .}}
  <script type="application/ld+json">{{.StructuredData}}</script>
  <!-- Privacy-friendly analytics by Plausible (self-hosted Community Edition) -->
  <link rel="preconnect" href="https://stats.via.moe">
  <script async src="https://stats.via.moe/js/pa-jfEuyewREQPgDS4n2-RHg.js"></script>
  <script>
    window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
    plausible.init({endpoint:'https://stats.via.moe/api/resource'})
  </script>
</head>
<body class="home">
{{template "header" .}}
<main id="main">

  <div class="intro">
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <a class="news" href="{{.Links.Changelog}}"><b>v{{.Version}}</b><span>{{t "heroNews"}}</span><svg class="ic" aria-hidden="true"><use href="#i-chev"/></svg></a>
        <h1 id="hero-title">{{t "heroTitle"}}</h1>
        <p class="hero-lede">{{t "heroLede"}}</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="#download" data-hero-download><svg class="ic" aria-hidden="true"><use href="#i-down"/></svg><span data-hero-download-label>{{t "heroDownload"}}</span></a>
          <a class="btn btn-ghost" href="{{.Links.Docs}}">{{t "heroDocs"}}</a>
        </div>
        <div class="hero-mac" data-hero-mac hidden>
          <p>{{t "heroMacNote"}}</p>
          <pre class="code"><code>xattr -dr com.apple.quarantine /Applications/Pail.app</code></pre>
        </div>
      </div>
      <div class="hero-stage">
        <ol class="drop-log" aria-hidden="true">
          <li><span class="verb">PUT</span><span class="k">website/index.html</span><span class="s">12 KiB</span><span class="ok">200</span></li>
          <li><span class="verb">PUT</span><span class="k">photos/2026/IMG_0412.heic</span><span class="s">3.1 MiB</span><span class="ok">200</span></li>
          <li><span class="verb">PUT</span><span class="k">reports/q4-report.pdf</span><span class="s">1.8 MiB</span><span class="ok">200</span></li>
        </ol>
      </div>
    </div>
  </section>

  <section class="window" id="window" aria-labelledby="window-title">
    <div class="wrap">
      <h2 class="lead" id="window-title">{{t "windowLead"}} <span>{{t "windowRest"}}</span></h2>
      <figure class="shot" data-shot>
        <div class="shot-frame">
          <picture>
            <source media="(prefers-color-scheme: dark)" srcset="{{asset (printf "main-dark-%s.webp" .Lang)}}" data-dark-source>
            <img src="{{asset (printf "main-light-%s.webp" .Lang)}}" width="2736" height="1822" alt="{{t "shotAlt"}}" decoding="async">
          </picture>
        </div>
        <figcaption class="zones">
          {{- range $i, $z := split (t "zones")}}{{$kv := split2 $z}}
          <span class="zone-text"><b>{{index $kv 0}}</b> {{index $kv 1}}</span>
          {{- end}}
        </figcaption>
      </figure>
    </div>
  </section>
  <canvas class="pail-layer" data-pail data-objects="reports/q4-report.pdf~1.8 MiB|photos/2026/IMG_0412.heic~3.1 MiB|backups/2026-11-20.tar~1.50 GiB|website/index.html~12 KiB|logs/app-2026-11-20.log.gz~840 KiB|invoices/2026-11.pdf~212 KiB|assets/hero@2x.webp~486 KiB|exports/customers.csv~96 KiB" aria-hidden="true"></canvas>
  </div>

  <section class="features" id="features" aria-labelledby="features-title">
    <div class="wrap">
      <h2 class="lead" id="features-title">{{t "featLead"}} <span>{{t "featRest"}}</span></h2>
      <div class="story" data-story>
        <div class="story-chapters">
          <article class="chapter" aria-labelledby="f-objects">
            <div class="chapter-text">
              <h3 id="f-objects">{{t "objectsTitle"}}</h3>
              <p>{{t "objectsBody"}}</p>
              <a class="more" href="{{.Links.Browse}}">{{t "objectsLink"}}<svg class="ic" aria-hidden="true"><use href="#i-chev"/></svg></a>
            </div>
            <div class="chapter-pane">{{template "pane-objects" .}}</div>
          </article>
          <article class="chapter" aria-labelledby="f-transfers">
            <div class="chapter-text">
              <h3 id="f-transfers">{{t "transfersTitle"}}</h3>
              <p>{{t "transfersBody"}}</p>
              <a class="more" href="{{.Links.Transfers}}">{{t "transfersLink"}}<svg class="ic" aria-hidden="true"><use href="#i-chev"/></svg></a>
            </div>
            <div class="chapter-pane">{{template "pane-transfers" .}}</div>
          </article>
          <article class="chapter" aria-labelledby="f-versions">
            <div class="chapter-text">
              <h3 id="f-versions">{{t "versionsTitle"}}</h3>
              <p>{{t "versionsBody"}}</p>
              <a class="more" href="{{.Links.Versions}}">{{t "versionsLink"}}<svg class="ic" aria-hidden="true"><use href="#i-chev"/></svg></a>
            </div>
            <div class="chapter-pane">{{template "pane-versions" .}}</div>
          </article>
          <article class="chapter" aria-labelledby="f-links">
            <div class="chapter-text">
              <h3 id="f-links">{{t "linksTitle"}}</h3>
              <p>{{t "linksBody"}}</p>
              <a class="more" href="{{.Links.Links}}">{{t "linksLink"}}<svg class="ic" aria-hidden="true"><use href="#i-chev"/></svg></a>
            </div>
            <div class="chapter-pane">{{template "pane-links" .}}</div>
          </article>
          <article class="chapter" aria-labelledby="f-sync">
            <div class="chapter-text">
              <h3 id="f-sync">{{t "syncTitle"}}</h3>
              <p>{{t "syncBody"}}</p>
              <a class="more" href="{{.Links.Sync}}">{{t "syncLink"}}<svg class="ic" aria-hidden="true"><use href="#i-chev"/></svg></a>
            </div>
            <div class="chapter-pane">{{template "pane-sync" .}}</div>
          </article>
        </div>
        <div class="story-stage">
          <div class="win-slot">
            <div class="win">
              <div class="win-bar">
                <span class="win-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                <nav class="win-tabs" aria-label="{{t "storyTabs"}}">
                  {{- range split "objects~tabObjects|transfers~tabTransfers|versions~tabVersions|links~tabLink|sync~tabSync"}}{{$a := split2 .}}
                  <a href="#f-{{index $a 0}}" data-tab="{{index $a 0}}" data-label="{{t (index $a 1)}}">{{t (index $a 1)}}</a>
                  {{- end}}
                </nav>
              </div>
              <div class="win-prog" aria-hidden="true"><i></i></div>
              <div class="win-body"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="cli" id="cli" aria-labelledby="cli-title">
    <div class="wrap cli-grid">
      <div class="sec-head">
        <h2 class="lead" id="cli-title">{{t "cliLead"}} <span>{{t "cliRest"}}</span></h2>
        <a class="more" href="{{.Links.Cli}}">{{t "cliLink"}}<svg class="ic" aria-hidden="true"><use href="#i-chev"/></svg></a>
      </div>
      <div class="term" data-term>
        <div class="term-bar">
          <span class="term-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <div class="term-tabs" role="tablist" aria-label="{{t "cliTabs"}}" hidden>
            {{- range $i, $e := .CLI.Examples}}
            <button type="button" role="tab" id="tab-{{$e.ID}}" aria-controls="term-out" aria-selected="{{if eq $i 0}}true{{else}}false{{end}}" tabindex="{{if eq $i 0}}0{{else}}-1{{end}}" data-example="{{$i}}">{{$e.Tab}}</button>
            {{- end}}
          </div>
        </div>
        {{- $first := index .CLI.Examples 0}}
        <pre class="term-out" id="term-out" role="tabpanel" aria-labelledby="tab-{{$first.ID}}" tabindex="0"><code>{{range $first.Lines}}<span class="t-line">{{termLine .}}</span>
{{end}}</code></pre>
      </div>
      <p class="term-note">{{t "cliNote"}}</p>
      <script type="application/json" id="cli-demo">{{.CLIJSON}}</script>
    </div>
  </section>

  <section class="more-sec" aria-labelledby="more-title">
    <div class="wrap more-grid">
      <div class="more-head">
        <h2 class="lead" id="more-title">{{t "moreLead"}} <span>{{t "moreRest"}}</span></h2>
        <a class="more" href="{{.Links.Docs}}">{{t "moreLink"}}<svg class="ic" aria-hidden="true"><use href="#i-chev"/></svg></a>
      </div>
      <div class="cmdk" data-cmdk>
        <div class="cmdk-field" hidden>
          <svg class="ic" aria-hidden="true"><use href="#i-search"/></svg>
          <input type="search" autocomplete="off" spellcheck="false" placeholder="{{t "moreFilter"}}" aria-label="{{t "moreFilter"}}" aria-controls="cmdk-list">
        </div>
        <ul class="cmdk-list" id="cmdk-list">
          {{- range split (t "more")}}{{$a := split3 .}}
          <li><a href="{{index $.MoreLinks (index $a 0)}}"><svg class="ic" aria-hidden="true"><use href="#i-{{index $a 0}}"/></svg><h3>{{index $a 1}}</h3><p>{{index $a 2}}</p><svg class="ic go" aria-hidden="true"><use href="#i-chev"/></svg></a></li>
          {{- end}}
        </ul>
        <p class="cmdk-empty" role="status" data-none="{{t "moreNone"}}"></p>
      </div>
    </div>
  </section>

  <section class="privacy" id="privacy" aria-labelledby="privacy-title">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="lead" id="privacy-title">{{t "privLead"}} <span>{{t "privRest"}}</span></h2>
        <a class="more" href="{{.Links.Privacy}}">{{t "privLink"}}<svg class="ic" aria-hidden="true"><use href="#i-chev"/></svg></a>
      </div>
      <dl class="priv">
        {{- range split (t "priv")}}{{$kv := split2 .}}
        <div><dt>{{index $kv 0}}</dt><dd>{{index $kv 1}}</dd></div>
        {{- end}}
      </dl>
    </div>
  </section>

  <section class="learn" aria-labelledby="learn-title">
    <div class="wrap">
      <h2 class="lead" id="learn-title">{{t "learnLead"}} <span>{{t "learnRest"}}</span></h2>
      <ul class="learn-list">
        {{- range .Learn}}
        <li><a href="{{.URL}}"><b>{{.Title}}</b><span>{{.Lede}}</span><svg class="ic" aria-hidden="true"><use href="#i-chev"/></svg></a></li>
        {{- end}}
      </ul>
    </div>
  </section>

  <section class="download" id="download" aria-labelledby="download-title">
    <div class="wrap">
      <div class="dl-head">
        <div>
          <h2 id="download-title">{{t "dlTitle"}} <span class="dl-ver">{{.Version}}</span></h2>
          <p>{{t "dlBody"}}{{if .ReleasedText}} {{.ReleasedText}}{{end}}</p>
        </div>
        {{- if .MirrorBase}}
        <fieldset class="source" data-source hidden>
          <legend class="sr">{{t "sourceLabel"}}</legend>
          <label><input type="radio" name="source" value="github" checked><span>GitHub</span></label>
          <label><input type="radio" name="source" value="mirror"><span>{{t "sourceMirror"}}</span></label>
        </fieldset>
        {{- end}}
      </div>
      <div class="dl-table" data-downloads data-release-base="{{.ReleaseBase}}/"{{if .MirrorBase}} data-mirror-base="{{.MirrorBase}}"{{end}}>
        {{- range split "windows|macos|linux"}}{{$os := .}}
        <section class="dl-os" data-os="{{$os}}" aria-labelledby="dl-{{$os}}">
          <div class="dl-sys">
            <h3 id="dl-{{$os}}">{{t (printf "os_%s" $os)}}</h3>
            <p class="dl-yours">{{t "dlYours"}}</p>
            <p class="dl-note">{{t (printf "dlNote_%s" $os)}}</p>
          </div>
          <ul>
            {{- range split (t (printf "dl_%s" $os))}}{{$a := split2 .}}{{$target := index $a 0}}
            <li><a class="dl{{if eq $target "windows-amd64.zip" "darwin-arm64.zip" "linux-amd64.tar.gz"}} dl-usual{{end}}" href="{{download $target}}" data-file="{{archive $target}}"{{if eq $target "windows-amd64.zip" "darwin-arm64.zip" "linux-amd64.tar.gz"}} data-usual{{end}}>
              <span class="dl-arch">{{index $a 1}}</span><span class="dl-file">{{archive $target}}</span><svg class="ic" aria-hidden="true"><use href="#i-down"/></svg></a></li>
            {{- end}}
          </ul>
          {{- if eq $os "macos"}}
          <div class="dl-cmd">
            <p>{{t "dlMacCmd"}}</p>
            <pre class="code" tabindex="0"><code>xattr -dr com.apple.quarantine /Applications/Pail.app</code></pre>
          </div>
          {{- end}}
        </section>
        {{- end}}
      </div>
      <output class="source-note" data-source-note>{{if .MirrorBase}}{{t "sourceGithubNote"}}{{end}}</output>
      <div class="verify">
        <div>
          <h3>{{t "verifyTitle"}}</h3>
          <p>{{t "verifyBody"}} <a href="{{.ReleaseBase}}/SHA256SUMS" data-file="SHA256SUMS">SHA256SUMS</a></p>
          <a class="more" href="{{.Links.Install}}">{{t "installNotes"}}<svg class="ic" aria-hidden="true"><use href="#i-chev"/></svg></a>
        </div>
        <pre class="code" tabindex="0"><code>sha256sum Pail-v{{.Version}}-linux-amd64.tar.gz    <span class="c">{{t "verifyLinux"}}</span>
shasum -a 256 Pail-v{{.Version}}-darwin-arm64.zip  <span class="c">{{t "verifyMac"}}</span>
Get-FileHash Pail-v{{.Version}}-windows-amd64.zip  <span class="c">{{t "verifyWindows"}}</span></code></pre>
      </div>
      {{- if .MirrorBase}}
      <p class="mirror-plain">{{t "mirrorPlain"}} <a href="{{.MirrorBase}}">{{.MirrorLabel}}</a></p>
      {{- end}}
    </div>
  </section>
</main>
{{template "footer" .}}
{{template "palette" .}}
<script src="{{asset "home.js"}}" defer></script>
</body>
</html>
