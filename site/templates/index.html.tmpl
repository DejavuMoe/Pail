<!DOCTYPE html>
<html lang="{{.HTMLLang}}" data-lang="{{.Lang}}" data-theme="light" data-theme-pref="system">
<head prefix="og: https://ogp.me/ns#">
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{t "docTitle"}}</title>
  <meta name="description" content="{{t "docDescription"}}">
  {{template "social" .}}
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#FBFAF8" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#151513" media="(prefers-color-scheme: dark)">
  <link rel="canonical" href="{{.Canonical}}">
  <link rel="alternate" hreflang="en" href="{{.URLEn}}">
  <link rel="alternate" hreflang="zh-Hans" href="{{.URLZh}}">
  <link rel="alternate" hreflang="x-default" href="{{.URLEn}}">
  <link rel="icon" href="{{asset "pail-icon.svg"}}" type="image/svg+xml">
  <script>
    (function () {
      var d = document.documentElement, pref = 'system', lang = null;
      try { pref = localStorage.getItem('pail-theme') || 'system'; lang = localStorage.getItem('pail-lang'); } catch (e) {}
      {{- if eq .Lang "en"}}
      if (lang === 'zh' || (lang === null && /^zh\b/i.test(navigator.language || ''))) { location.replace({{.PathZh}} + location.hash); return; }
      {{- end}}
      if (pref !== 'light' && pref !== 'dark') pref = 'system';
      var dark = pref === 'dark' || (pref === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
      d.setAttribute('data-theme-pref', pref);
      d.setAttribute('data-theme', dark ? 'dark' : 'light');
      d.classList.add('js');
    })();
  </script>
  <link rel="stylesheet" href="{{asset "styles.css"}}">
</head>
<body>
  <svg class="sprite" aria-hidden="true" focusable="false">
    <symbol id="i-monitor" viewBox="0 0 24 24"><rect width="20" height="14" x="2" y="3" rx="2"></rect><path d="M8 21h8"></path><path d="M12 17v4"></path></symbol>
    <symbol id="i-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path></symbol>
    <symbol id="i-moon" viewBox="0 0 24 24"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></symbol>
    <symbol id="i-github" viewBox="0 0 24 24"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></symbol>
    <symbol id="i-download" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><path d="m7 10 5 5 5-5"></path><path d="M12 15V3"></path></symbol>
    <symbol id="i-arrow-up" viewBox="0 0 24 24"><path d="m5 12 7-7 7 7"></path><path d="M12 19V5"></path></symbol>
    <symbol id="i-arrow-down" viewBox="0 0 24 24"><path d="M12 5v14"></path><path d="m19 12-7 7-7-7"></path></symbol>
    <symbol id="i-arrow-right" viewBox="0 0 24 24"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></symbol>
    <symbol id="i-check" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"></path></symbol>
    <symbol id="i-file" viewBox="0 0 24 24"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path></symbol>
    <symbol id="i-history" viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path><path d="M12 7v5l4 2"></path></symbol>
    <symbol id="i-globe" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path><path d="M2 12h20"></path></symbol>
    <symbol id="i-menu" viewBox="0 0 24 24"><path d="M4 12h16"></path><path d="M4 6h16"></path><path d="M4 18h16"></path></symbol>
  </svg>

  <a class="skip-link" href="#main">{{t "skip"}}</a>

  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href="#top">
        <img src="{{asset "pail-icon.svg"}}" alt="" width="28" height="28">
        <span>Pail</span>
      </a>
      <nav class="nav" aria-label="{{t "navLabel"}}">
        <a href="#features">{{t "navFeatures"}}</a>
        <a href="#cli">{{t "navCli"}}</a>
        <a href="#privacy">{{t "navPrivacy"}}</a>
        <a href="#download">{{t "navDownload"}}</a>
        <a href="{{.Links.Docs}}">{{t "navDocs"}}</a>
      </nav>
      <div class="header-actions">
        <a class="icon-btn lang-btn" href="{{.OtherPath}}" hreflang="{{.OtherHTMLLang}}" lang="{{.OtherHTMLLang}}" data-action="lang" data-lang-target="{{.OtherLang}}" aria-label="{{t "langSwitch"}}">
          <svg class="i" aria-hidden="true" focusable="false"><use href="#i-globe"></use></svg>
          <span>{{t "langShort"}}</span>
        </a>
        <fieldset class="seg theme-seg">
          <legend class="visually-hidden">{{t "themeLabel"}}</legend>
          <label title="{{t "themeSystem"}}"><input type="radio" name="theme" value="system" checked><span class="seg-face"><svg class="i" aria-hidden="true" focusable="false"><use href="#i-monitor"></use></svg></span><span class="visually-hidden">{{t "themeSystem"}}</span></label>
          <label title="{{t "themeLight"}}"><input type="radio" name="theme" value="light"><span class="seg-face"><svg class="i" aria-hidden="true" focusable="false"><use href="#i-sun"></use></svg></span><span class="visually-hidden">{{t "themeLight"}}</span></label>
          <label title="{{t "themeDark"}}"><input type="radio" name="theme" value="dark"><span class="seg-face"><svg class="i" aria-hidden="true" focusable="false"><use href="#i-moon"></use></svg></span><span class="visually-hidden">{{t "themeDark"}}</span></label>
        </fieldset>
        <a class="icon-btn gh-btn" href="{{.GitHub}}" aria-label="GitHub">
          <svg class="i" aria-hidden="true" focusable="false"><use href="#i-github"></use></svg>
        </a>
        <button class="icon-btn menu-btn" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="{{t "menu"}}">
          <svg class="i" aria-hidden="true" focusable="false"><use href="#i-menu"></use></svg>
        </button>
      </div>
    </div>
    <nav id="mobile-nav" class="mobile-nav" hidden aria-label="{{t "menu"}}">
      <a href="#features">{{t "navFeatures"}}</a>
      <a href="#cli">{{t "navCli"}}</a>
      <a href="#privacy">{{t "navPrivacy"}}</a>
      <a href="#download">{{t "navDownload"}}</a>
      <a href="{{.Links.Docs}}">{{t "navDocs"}}</a>
    </nav>
  </header>

  <main id="main">
    <section class="hero" id="top">
      <div class="wrap hero-copy">
        <h1 class="hero-title">{{t "heroTitle"}}</h1>
        <p class="hero-sub">{{t "heroSub"}}</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="#download" data-os-cta>
            <svg class="i" aria-hidden="true" focusable="false"><use href="#i-download"></use></svg>
            <span data-os-cta-label>{{t "heroDownload"}}</span>
          </a>
          <a class="btn btn-secondary" href="{{.GitHub}}">
            <svg class="i" aria-hidden="true" focusable="false"><use href="#i-github"></use></svg>
            <span>{{t "heroGithub"}}</span>
          </a>
        </div>
        <p class="hero-meta">
          <a href="{{.Links.Changelog}}">{{t "metaVersion"}} {{.Version}}</a>
          <span aria-hidden="true">·</span>
          <a href="{{.Links.License}}">{{t "metaLicense"}}</a>
        </p>
      </div>
      <figure class="wrap hero-shot">
        <picture>
          <source srcset="{{asset "main-dark.webp"}}" media="(prefers-color-scheme: dark)" type="image/webp" data-shot-dark>
          <img src="{{asset "main-light.webp"}}" width="2742" height="1822" fetchpriority="high" decoding="async" alt="{{t "shotAlt"}}">
        </picture>
        <script>
          (function () {
            var p = document.documentElement.getAttribute('data-theme-pref');
            var s = document.querySelector('[data-shot-dark]');
            if (s && p !== 'system') s.media = p === 'dark' ? 'all' : 'not all';
          })();
        </script>
      </figure>
      <div class="wrap providers">
        <p><span>{{t "providersTested"}}</span> <span class="providers-list"><b>Amazon S3</b><b>Cloudflare R2</b><b>MinIO</b><b>Wasabi</b><b>VersityGW</b></span></p>
        <p>{{t "providersOther"}}</p>
      </div>
    </section>

    <section class="section" id="features" aria-labelledby="features-title">
      <div class="wrap">
        <h2 class="section-title reveal" id="features-title">{{t "featuresTitle"}}</h2>

        <article class="showcase reveal">
          <div class="showcase-copy">
            <h3>{{t "fTransfersTitle"}}</h3>
            <p>{{t "fTransfersBody"}}</p>
          </div>
          <div class="mini mini-transfers" aria-hidden="true">
            <div class="tq-head">
              <span class="tq-title">{{t "miniTransfers"}}</span>
              <span class="tq-filter is-on"><span>{{t "miniActive"}}</span> 2</span>
              <span class="tq-filter"><span>{{t "miniCompleted"}}</span> 1</span>
            </div>
            <div class="tq-row" data-total="2306867">
              <svg class="i" aria-hidden="true" focusable="false"><use href="#i-arrow-up"></use></svg>
              <span class="tq-name">site/assets/hero.webp</span>
              <span class="tq-bar"><i></i></span>
              <span class="tq-bytes">1.4 MB / 2.2 MB</span>
            </div>
            <div class="tq-row" data-total="2576980378">
              <svg class="i" aria-hidden="true" focusable="false"><use href="#i-arrow-down"></use></svg>
              <span class="tq-name">backups/2026-10-19.tar.gz</span>
              <span class="tq-bar"><i></i></span>
              <span class="tq-bytes">1.6 GB / 2.4 GB</span>
            </div>
            <div class="tq-row is-done">
              <svg class="i" aria-hidden="true" focusable="false"><use href="#i-check"></use></svg>
              <span class="tq-name">reports/q3.csv</span>
              <span class="tq-bar"><i></i></span>
              <span class="tq-bytes">18.3 KB</span>
            </div>
            <div class="conflict">
              <span class="conflict-label">{{t "miniConflictRow"}}</span>
              <div class="chips" data-cycle>
                <span class="chip is-on">{{t "conflictRename"}}</span>
                <span class="chip">{{t "conflictSkip"}}</span>
                <span class="chip">{{t "conflictOverwrite"}}</span>
                <span class="chip">{{t "conflictNewer"}}</span>
                <span class="chip">{{t "conflictSize"}}</span>
              </div>
            </div>
          </div>
        </article>

        <article class="showcase showcase-flip reveal">
          <div class="showcase-copy">
            <h3>{{t "fVersionsTitle"}}</h3>
            <p>{{t "fVersionsBody"}}</p>
          </div>
          <div class="mini mini-versions" aria-hidden="true">
            <div class="mv-key"><svg class="i" aria-hidden="true" focusable="false"><use href="#i-file"></use></svg><span>reports/q3.csv</span></div>
            <ol class="mv-list">
              <li class="mv-marker"><span class="mv-dot"></span><span class="mv-label">{{t "miniDeleteMarker"}}</span><span class="mv-badge">{{t "miniLatest"}}</span><span class="mv-time">2026-10-19 22:51</span></li>
              <li class="mv-target"><span class="mv-dot"></span><span class="mv-id">3HL4kqtJlcpX</span><span class="mv-size">18.3 KB</span><span class="mv-restore"><svg class="i" aria-hidden="true" focusable="false"><use href="#i-history"></use></svg><span>{{t "miniRestore"}}</span></span></li>
              <li><span class="mv-dot"></span><span class="mv-id">Xd3dIbrHYrmS</span><span class="mv-size">17.9 KB</span><span class="mv-time">2026-10-12 09:04</span></li>
            </ol>
          </div>
        </article>

        <ul class="facts facts-3">
          <li class="reveal"><h3>{{t "fAccountsTitle"}}</h3><p>{{t "fAccountsBody"}}</p></li>
          <li class="reveal"><h3>{{t "fSettingsTitle"}}</h3><p>{{t "fSettingsBody"}}</p></li>
          <li class="reveal"><h3>{{t "fPropsTitle"}}</h3><p>{{t "fPropsBody"}}</p></li>
          <li class="reveal"><h3>{{t "fSyncTitle"}}</h3><p>{{t "fSyncBody"}}</p></li>
          <li class="reveal"><h3>{{t "fLinksTitle"}}</h3><p>{{t "fLinksBody"}}</p></li>
          <li class="reveal"><h3>{{t "fRulesTitle"}}</h3><p>{{t "fRulesBody"}}</p></li>
        </ul>
      </div>
    </section>

    <section class="section" id="cli" aria-labelledby="cli-title">
      <div class="wrap split">
        <div class="split-copy reveal">
          <h2 class="section-title" id="cli-title">{{t "cliTitle"}}</h2>
          <p class="section-lede">{{t "cliBody"}}</p>
          <a class="text-link" href="{{.Links.Cli}}"><span>{{t "cliDocs"}}</span><svg class="i" aria-hidden="true" focusable="false"><use href="#i-arrow-right"></use></svg></a>
        </div>
        <div class="terminal reveal" data-demo="terminal">
          <div class="term-bar">
            <div class="term-tabs" role="tablist" aria-label="{{t "cliExamples"}}">
              <button type="button" role="tab" aria-selected="true" data-term="ls" id="term-tab-ls" aria-controls="term-panel">ls</button>
              <button type="button" role="tab" aria-selected="false" data-term="sync" id="term-tab-sync" aria-controls="term-panel">sync</button>
              <button type="button" role="tab" aria-selected="false" data-term="presign" id="term-tab-presign" aria-controls="term-panel">presign</button>
              <button type="button" role="tab" aria-selected="false" data-term="json" id="term-tab-json" aria-controls="term-panel">--json</button>
            </div>
          </div>
          <pre class="term-body" id="term-panel" role="tabpanel" aria-labelledby="term-tab-ls" tabindex="0"><code><span class="t-prompt">$</span> <span class="t-cmd">pail ls s3://acme-assets/</span>
<span class="t-out">                                PRE assets/</span>
<span class="t-out">                                PRE backups/</span>
<span class="t-out">                                PRE logs/</span>
<span class="t-out">                                PRE reports/</span>
<span class="t-out">                                PRE website/</span>
<span class="t-out">2026-10-19 14:51:08        303 B  manifest.json</span>
<span class="t-out">2026-10-19 14:51:08        445 B  README.txt</span></code></pre>
        </div>
      </div>
    </section>

    <section class="section" id="privacy" aria-labelledby="privacy-title">
      <div class="wrap">
        <div class="section-head reveal">
          <h2 class="section-title" id="privacy-title">{{t "privacyTitle"}}</h2>
          <p class="section-lede">{{t "privacyLede"}}</p>
        </div>
        <ul class="facts facts-4">
          <li class="reveal"><h3>{{t "pNetTitle"}}</h3><p>{{t "pNetBody"}}</p></li>
          <li class="reveal"><h3>{{t "pKeysTitle"}}</h3><p>{{t "pKeysBody"}}</p></li>
          <li class="reveal"><h3>{{t "pLogTitle"}}</h3><p>{{t "pLogBody"}}</p></li>
          <li class="reveal"><h3>{{t "pScopeTitle"}}</h3><p>{{t "pScopeBody"}}</p></li>
        </ul>
      </div>
    </section>

    <section class="section" id="download" aria-labelledby="download-title">
      <div class="wrap split split-download">
        <div class="split-copy reveal">
          <h2 class="section-title" id="download-title"><span>{{t "downloadTitle"}}</span> <span class="version">{{.Version}}</span></h2>
          <p class="download-meta">{{if .Released}}<span>{{.Released}}</span> · {{end}}<a href="{{.Links.Changelog}}">{{t "changelog"}}</a></p>
          <p class="download-note"><span>{{t "downloadNote"}}</span> <a href="{{.Links.Docs}}#install">{{t "installNotes"}}</a></p>
          <ul class="download-links">
            <li><a href="{{.ReleaseBase}}/SHA256SUMS">SHA256SUMS</a></li>
            <li><a href="{{.GitHub}}/releases">{{t "allReleases"}}</a></li>
            <li><a href="{{.Links.Build}}">{{t "buildFromSource"}}</a></li>
          </ul>
          <p class="demo-hint"><span>{{t "demoHint1"}}</span> <code>pail-desktop --demo</code> <span>{{t "demoHint2"}}</span></p>
        </div>

        <div class="dl reveal" data-github-base="{{.ReleaseBase}}/"{{if .MirrorBase}} data-mirror-base="{{.MirrorBase}}"{{end}}>
{{- if .MirrorBase}}
          <div class="dl-source">
            <fieldset class="source-pick">
              <legend>{{t "sourceLabel"}}</legend>
              <div class="seg source-seg">
                <label><input type="radio" name="source" value="github" checked><span class="seg-face"><span data-label="GitHub">GitHub</span></span></label>
                <label><input type="radio" name="source" value="mirror"><span class="seg-face"><span data-label="{{t "sourceMirror"}}">{{t "sourceMirror"}}</span></span></label>
              </div>
            </fieldset>
            <p class="source-note"><span aria-live="polite" data-source-note>{{t "sourceGithubNote"}}</span><span class="source-note-sizer" aria-hidden="true">{{t "sourceGithubNote"}}</span><span class="source-note-sizer" aria-hidden="true">{{t "sourceMirrorNote"}}</span></p>
            <p class="source-fallback"><span>{{t "mirrorFallback"}}</span> <a href="{{.MirrorBase}}">{{.MirrorLabel}}</a></p>
          </div>
{{- end}}
          <ul class="dl-list">
            <li class="dl-row" data-os="windows">
              <div class="dl-os"><h3>Windows</h3><span class="os-badge">{{t "yourSystem"}}</span><p>{{t "osWindowsReq"}}</p></div>
              <div class="dl-links">
                <a class="dl-link" data-asset="{{archive "windows-amd64.zip"}}" href="{{download "windows-amd64.zip"}}"><svg class="i" aria-hidden="true" focusable="false"><use href="#i-download"></use></svg><span>x64</span><small>amd64</small></a>
                <a class="dl-link" data-asset="{{archive "windows-arm64.zip"}}" href="{{download "windows-arm64.zip"}}"><svg class="i" aria-hidden="true" focusable="false"><use href="#i-download"></use></svg><span>Arm</span><small>arm64</small></a>
              </div>
            </li>
            <li class="dl-row" data-os="macos">
              <div class="dl-os"><h3>macOS</h3><span class="os-badge">{{t "yourSystem"}}</span><p>{{t "osMacReq"}}</p></div>
              <div class="dl-links">
                <a class="dl-link" data-asset="{{archive "darwin-arm64.zip"}}" href="{{download "darwin-arm64.zip"}}"><svg class="i" aria-hidden="true" focusable="false"><use href="#i-download"></use></svg><span>{{t "appleSilicon"}}</span><small>arm64</small></a>
                <a class="dl-link" data-asset="{{archive "darwin-amd64.zip"}}" href="{{download "darwin-amd64.zip"}}"><svg class="i" aria-hidden="true" focusable="false"><use href="#i-download"></use></svg><span>Intel</span><small>amd64</small></a>
              </div>
            </li>
            <li class="dl-row" data-os="linux">
              <div class="dl-os"><h3>Linux</h3><span class="os-badge">{{t "yourSystem"}}</span><p>{{t "osLinuxReq"}}</p></div>
              <div class="dl-links">
                <a class="dl-link" data-asset="{{archive "linux-amd64.tar.gz"}}" href="{{download "linux-amd64.tar.gz"}}"><svg class="i" aria-hidden="true" focusable="false"><use href="#i-download"></use></svg><span>x64</span><small>amd64</small></a>
                <a class="dl-link" data-asset="{{archive "linux-arm64.tar.gz"}}" href="{{download "linux-arm64.tar.gz"}}"><svg class="i" aria-hidden="true" focusable="false"><use href="#i-download"></use></svg><span>Arm</span><small>arm64</small></a>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </section>
  </main>

  {{template "footer" .}}

  <script type="application/json" id="pail-strings">{{.Runtime}}</script>
  <script src="{{asset "app.js"}}"></script>
</body>
</html>
