{{define "footer"}}
  <footer class="site-footer">
    <div class="wrap footer-inner">
      <a class="brand" href="{{.Links.Home}}"><img src="{{asset "pail-icon.svg"}}" alt="" width="24" height="24"><span>Pail</span></a>
      <nav class="footer-nav" aria-label="{{t "footNavLabel"}}">
        <a href="{{.Links.Docs}}">{{t "navDocs"}}</a>
        <a href="{{.Links.Cli}}">{{t "navCli"}}</a>
        <a href="{{.Links.Changelog}}">{{t "changelog"}}</a>
        <a href="{{.GitHub}}/releases">{{t "releases"}}</a>
        <a href="{{.GitHub}}/issues">{{t "issues"}}</a>
        <a href="{{.GitHub}}">GitHub</a>
        <a href="{{.Links.License}}">{{t "license"}}</a>
      </nav>
    </div>
    <div class="wrap footer-legal">
      <p>{{t "trademark"}}</p>
    </div>
  </footer>
{{end}}
